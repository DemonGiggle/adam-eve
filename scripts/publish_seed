#!/usr/bin/env python3
"""Build and durably publish the trusted boot seed."""
import argparse
from pathlib import Path
import shutil
import tempfile
from ae_publish import data_root, publication_lock, publish, run


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data-root", required=True, type=Path)
    args = parser.parse_args()
    root = data_root(args.data_root)
    checkout = Path(__file__).resolve().parent.parent
    with publication_lock(root):
        if (root / "bootstrap.json").exists() or (root / "state/agent.sqlite3").exists():
            parser.error("identity already provisioned; use its retained seed or publish_candidate")
        with tempfile.TemporaryDirectory(prefix="seed-", dir=root / "workspaces") as directory:
            workspace = Path(directory)
            for app in ("ae_seed", "ae_protocol"):
                shutil.copytree(checkout / "apps" / app, workspace / "apps" / app,
                    ignore=shutil.ignore_patterns("_build", "*.beam", "erl_crash.dump", "__pycache__"))
            (workspace / ".gitignore").write_text("_build/\n**/_build/\n")
            run("git", "init", str(workspace))
            run("git", "add", ".", cwd=workspace)
            manifest = publish(root, workspace)
    print(f"Published seed sha256:{manifest['digest']} in {root}")


if __name__ == "__main__":
    main()
