#!/usr/bin/env python3
"""Build a trusted manual patch against the persisted active source.

This development command executes the build as the operator. It is not an
isolated builder and must never execute AI-authored or untrusted code.
"""
import argparse
import json
from pathlib import Path
import sqlite3
import subprocess
import tempfile
from ae_publish import data_root, publication_lock, publish, run


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data-root", required=True, type=Path)
    parser.add_argument("--patch", required=True, type=Path)
    parser.add_argument("--objective", required=True)
    args = parser.parse_args()
    patch = args.patch.resolve()
    if not 0 < patch.stat().st_size <= 262144:
        parser.error("manual patch must be nonempty and at most 256 KiB")
    if not 0 < len(args.objective.encode()) <= 4096:
        parser.error("objective must be nonempty and at most 4096 bytes")
    root = data_root(args.data_root)
    with publication_lock(root):
        with sqlite3.connect((root / "state/agent.sqlite3").as_uri() + "?mode=ro", uri=True) as connection:
            baseline = json.loads(connection.execute("SELECT data FROM routing WHERE id=1").fetchone()[0])
        manifest = baseline["artifact"]
        repo = root / "source.git"
        revision = manifest["source_revision"]
        if run("git", "--git-dir", str(repo), "rev-parse", "refs/generations/" + manifest["digest"]) != revision:
            raise ValueError("active source reference no longer matches its registry record")
        run("git", "--git-dir", str(repo), "fsck", "--strict", "--no-reflogs", revision)
        with tempfile.TemporaryDirectory(prefix="manual-", dir=root / "workspaces") as directory:
            workspace = Path(directory)
            run("git", "init", str(workspace))
            run("git", "fetch", str(repo), revision, cwd=workspace)
            run("git", "checkout", "--detach", revision, cwd=workspace)
            run("git", "apply", "--check", "--index", str(patch), cwd=workspace)
            run("git", "apply", "--index", str(patch), cwd=workspace)
            data = subprocess.check_output(["git", "diff", "--cached", "--name-only", "-z"], cwd=workspace)
            paths = [p.decode("utf-8") for p in data.split(b"\0") if p]
            if not paths or any(not p.startswith(("apps/ae_seed/src/", "apps/ae_seed/test/")) for p in paths):
                raise ValueError("manual patch may change only seed source and seed tests")
            index = run("git", "ls-files", "--stage", cwd=workspace)
            if any(line.startswith(("120000 ", "160000 ")) for line in index.splitlines()):
                raise ValueError("symlinks and submodules are not permitted")
            candidate = publish(root, workspace, manifest["digest"], args.objective)
    print(json.dumps(candidate, sort_keys=True))


if __name__ == "__main__":
    main()
