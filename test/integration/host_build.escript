#!/usr/bin/env escript
%%! +S 2:2 +A 1
main([Root, Package]) ->
    ok = code:add_pathsa(filelib:wildcard("_build/default/lib/*/ebin")),
    {ok, _} = application:ensure_all_started(crypto),
    Base = ae_artifacts:bootstrap(Root),
    Id = ae_policy:sha256(<<"native-host-build-test">>),
    Now = erlang:system_time(millisecond),
    Limits = #{<<"max_patch_bytes">> => 4096, <<"total_ms">> => 120000,
        <<"build_ms">> => 60000, <<"cpu_ms">> => 60000, <<"disk_reserve_bytes">> => 1048576,
        <<"max_diagnostic_bytes">> => 1024},
    Job = #{<<"id">> => Id, <<"status">> => <<"building">>, <<"attempts">> => 1,
        <<"baseline">> => #{<<"artifact">> => Base, <<"epoch">> => 1},
        <<"limits">> => Limits, <<"deadline">> => Now + 120000, <<"objective">> => <<"native build fixture">>},
    Patch = <<"diff --git a/apps/ae_seed/src/seed_agent.erl b/apps/ae_seed/src/seed_agent.erl\n",
        "--- a/apps/ae_seed/src/seed_agent.erl\n+++ b/apps/ae_seed/src/seed_agent.erl\n",
        "@@ -1 +1 @@\n--module(seed_agent).\n+-module(seed_agent). % host builder\n">>,
    Proposal = #{<<"attempt">> => 1, <<"base_artifact">> => maps:get(<<"digest">>, Base),
        <<"base_source_revision">> => maps:get(<<"source_revision">>, Base), <<"epoch">> => 1,
        <<"patch">> => Patch, <<"patch_hash">> => ae_policy:sha256(Patch),
        <<"paths">> => [<<"apps/ae_seed/src/seed_agent.erl">>]},
    Lease = #{<<"job_id">> => Id, <<"attempt">> => 1, <<"kind">> => <<"build">>, <<"status">> => <<"reserved">>,
        <<"cpu_ms">> => 60000, <<"wall_ms">> => 60000, <<"reserved_at_ms">> => Now, <<"expires_at_ms">> => Now + 60000},
    Config = #{<<"jsx_package">> => list_to_binary(Package), <<"source_bytes">> => 2097152,
        <<"source_files">> => 128, <<"artifact_bytes">> => 8388608, <<"output_bytes">> => 16777216,
        <<"cpu_ms">> => 60000, <<"wall_ms">> => 60000},
    Denied = filename:join([Root, "workspaces", "native-denied"]), ok = file:make_dir(Denied),
    {error, build_failed, <<>>} = ae_host_build:build(Root, Job, Proposal,
        Lease#{<<"job_id">> := <<"wrong">>}, Config, Denied),
    {error, build_failed, <<>>} = ae_host_build:build(Root,
        Job#{<<"limits">> := Limits#{<<"disk_reserve_bytes">> := 1 bsl 62}}, Proposal, Lease, Config, Denied),
    {ok, []} = file:list_dir(Denied),
    Workspace = filename:join([Root, "workspaces", "native-test"]), ok = file:make_dir(Workspace),
    {ok, Manifest} = ae_host_build:build(Root, Job, Proposal, Lease, Config, Workspace),
    ok = ae_artifacts:verify(Root, Manifest), ok = ae_artifacts:verify_parent(Root, Manifest, Base),
    <<"host">> = maps:get(<<"resource_limits_mode">>, maps:get(<<"build_provenance">>, Manifest)),
    Repeat = filename:join([Root, "workspaces", "native-repeat"]), ok = file:make_dir(Repeat),
    {ok, Manifest} = ae_host_build:build(Root, Job, Proposal, Lease, Config, Repeat),
    Eval = #{<<"startup_ms">> => 30000, <<"turn_ms">> => 15000},
    Policy = #{<<"max_tool_requests">> => 8},
    Case = #{<<"history">> => [], <<"message">> => <<"hello">>,
        <<"expected_messages">> => [#{<<"role">> => <<"user">>, <<"content">> => <<"hello">>}],
        <<"model_result">> => #{<<"text">> => <<"fixture reply">>},
        <<"expected_type">> => <<"reply">>, <<"expected_text">> => <<"fixture reply">>},
    lists:foreach(fun(Item) ->
        {ok, Runtime} = ae_host_eval_runtime:start(Root, Item, Eval, erlang:monotonic_time(millisecond) + 30000),
        try
            #{success := true, calls := 1, reply := <<"fixture reply">>} = ae_host_eval_runtime:turn(Runtime, Case, Policy),
            ok = ae_host_eval_runtime:health(ae_host_eval_runtime:restore(Runtime, 12))
        after ae_host_eval_runtime:close(Runtime) end
    end, [Base, Manifest]),
    {ok, PolicyBytes} = file:read_file("test/evaluation/policy.json"),
    OriginalPolicy = jsx:decode(PolicyBytes, [return_maps]),
    Cases = [C#{<<"expected_text">> := binary:replace(maps:get(<<"expected_text">>, C), <<"authored:">>, <<>>)} ||
        C <- maps:get(<<"cases">>, OriginalPolicy)],
    EvalPolicy = OriginalPolicy#{<<"min_success_delta_ppm">> := 0, <<"repair_approval">> := <<"test repair">>,
        <<"cases">> := Cases},
    EvalConfig = #{<<"source_bytes">> => 2097152,
        <<"source_files">> => 128, <<"artifact_bytes">> => 8388608, <<"startup_ms">> => 30000,
        <<"turn_ms">> => 15000, <<"policy">> => EvalPolicy, <<"output_bytes">> => 1048576,
        <<"cpu_ms">> => 60000, <<"wall_ms">> => 60000},
    EvalJob = Job#{<<"status">> := <<"testing">>, <<"built_artifact">> => Manifest,
        <<"limits">> := Limits#{<<"evaluation_ms">> => 60000}},
    EvalNow = erlang:system_time(millisecond),
    Binding = maps:from_list([{K, ae_policy:sha256(K)} || K <- [<<"configuration_hash">>, <<"harness_hash">>,
        <<"test_recipe_hash">>, <<"sandbox_hash">>, <<"source_helper_hash">>]]),
    EvalLease = #{<<"id">> => ae_policy:sha256(<<"lease">>), <<"job_id">> => Id, <<"attempt">> => 1,
        <<"kind">> => <<"evaluate">>, <<"status">> => <<"reserved">>, <<"cpu_ms">> => 60000,
        <<"wall_ms">> => 60000, <<"reserved_at_ms">> => EvalNow, <<"expires_at_ms">> => EvalNow + 60000,
        <<"evaluation_binding">> => Binding},
    EvalWorkspace = filename:join([Root, "workspaces", "native-eval-test"]), ok = file:make_dir(EvalWorkspace),
    {ok, Scorecard} = ae_host_evaluate:evaluate(Root, EvalJob, EvalLease, EvalConfig, EvalWorkspace),
    true = maps:get(<<"passed">>, Scorecard),
    true = lists:all(fun(V) -> V end, maps:values(maps:get(<<"gates">>, Scorecard))),
    test_failure(Root, Base, "bad_tests", <<"-module(bad_tests).\n-include_lib(\"eunit/include/eunit.hrl\").\nfail_test() -> error(expected_unit_failure).\n">>, <<"expected_unit_failure">>),
    test_failure(Root, Base, "bad_SUITE", <<"-module(bad_SUITE).\n-export([all/0, fail/1]).\nall() -> [fail].\nfail(_) -> ct:fail(expected_ct_failure).\n">>, <<"expected_ct_failure">>),
    io:format("Erlang host build and evaluation passed: candidate, synthetic comparisons and rollback.~n").

test_failure(Root, Manifest, Name, Contents, Expected) ->
    Parent = filename:join([Root, "workspaces", Name]), ok = file:make_dir(Parent),
    Source = filename:join(Parent, "source"), Work = filename:join(Parent, "work"),
    ok = file:make_dir(Source), ok = file:make_dir(Work),
    Path = filename:join([Source, "apps", "ae_seed", "test", Name ++ ".erl"]),
    ok = filelib:ensure_dir(Path), ok = file:write_file(Path, Contents),
    Recipe = filename:join(code:priv_dir(ae_core), "test_seed.escript"),
    {error, {exit_status, _, Output}} = ae_host_command:run_capture("/usr/bin/escript",
        [Recipe, "1", Work, ae_artifacts:executable(Root, Manifest), Source], [], 60000, 1048576),
    true = binary:match(Output, Expected) =/= nomatch.
